# Discord OAuth2 application
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Bot token for server-side guild checks / dashboard data
DISCORD_BOT_TOKEN=your_bot_token

# Public site URL in production
PUBLIC_URL=http://localhost:3000

# Change this in production. Used to protect signed session cookies.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: where persistent JSON configuration is stored
DATA_FILE=./data/config.json
